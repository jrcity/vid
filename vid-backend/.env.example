# ── Nokia Network-as-Code ─────────────────────────────────────────────────────
# Get these from: network.developer.nokia.com → Your App → Credentials
NOKIA_NAC_TOKEN=your_nokia_nac_api_token_here

# ── App settings ──────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
SECRET_KEY=change_this_to_a_random_64_char_string
CORS_ORIGINS=http://localhost:3000,https://your-vercel-app.vercel.app

# ── Optional: Claude API for AI explainer ─────────────────────────────────────
# Only needed for the AI plain-language explanation feature
# ANTHROPIC_API_KEY=your_anthropic_key_here
